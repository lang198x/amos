{
  "name": "@lang198x/amos",
  "version": "0.2.0",
  "description": "AMOS TextMate grammar for Shiki and editor integrations",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lang198x/amos.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./amos.tmLanguage.json": "./syntaxes/amos.tmLanguage.json",
    "./amos-3d": {
      "types": "./amos-3d.d.ts",
      "import": "./amos-3d.mjs"
    },
    "./amos-3d.tmLanguage.json": "./syntaxes/amos-3d.tmLanguage.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "amos-3d.mjs",
    "amos-3d.d.ts",
    "syntaxes/amos-3d.tmLanguage.json",
    "syntaxes/amos.tmLanguage.json",
    "docs/coverage.md",
    "docs/provenance.md",
    "LICENSE",
    "docs/verification.md"
  ],
  "scripts": {
    "test": "node --test tests/package.test.mjs tests/manual-core.test.mjs tests/language-inventories.test.mjs tests/amos-3d-inventory.test.mjs tests/amos-3d-source.test.mjs tests/amos-3d-package.test.mjs",
    "test:integrations": "node --test tests/highlighting*.test.mjs",
    "check:editor": "node scripts/sync-editor.mjs --check",
    "prepack": "node scripts/sync-editor.mjs --check"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
