{
  "name": "@lang198x/amos",
  "version": "0.2.0",
  "description": "AMOS, AMAL and Interface TextMate grammars for Shiki and editors",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lang198x/amos.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./amos.tmLanguage.json": "./syntaxes/amos.tmLanguage.json",
    "./amos-3d": {
      "types": "./amos-3d.d.ts",
      "import": "./amos-3d.mjs"
    },
    "./amos-3d.tmLanguage.json": "./syntaxes/amos-3d.tmLanguage.json",
    "./amal": {
      "types": "./amal.d.ts",
      "import": "./amal.mjs"
    },
    "./amal.tmLanguage.json": "./syntaxes/amal.tmLanguage.json",
    "./interface": {
      "types": "./interface.d.ts",
      "import": "./interface.mjs"
    },
    "./interface.tmLanguage.json": "./syntaxes/interface.tmLanguage.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "amal.mjs",
    "amal.d.ts",
    "syntaxes/amal.tmLanguage.json",
    "interface.mjs",
    "interface.d.ts",
    "syntaxes/interface.tmLanguage.json",
    "amos-3d.mjs",
    "amos-3d.d.ts",
    "syntaxes/amos-3d.tmLanguage.json",
    "syntaxes/amos.tmLanguage.json",
    "docs/coverage.md",
    "docs/provenance.md",
    "docs/manual-reconciliation.md",
    "docs/error-catalogue-review.md",
    "docs/command-index-review.md",
    "docs/interface-inventory.md",
    "LICENSE",
    "docs/highlighting-readiness.md",
    "docs/verification.md"
  ],
  "scripts": {
    "test": "node --test tests/package.test.mjs tests/manual-core.test.mjs tests/language-inventories.test.mjs tests/amos-3d-inventory.test.mjs tests/amos-3d-source.test.mjs tests/amos-3d-package.test.mjs tests/amal-package.test.mjs tests/io-source.test.mjs tests/command-index.test.mjs tests/interface-inventory.test.mjs tests/tokenization-guard.test.mjs tests/interface-package.test.mjs tests/readiness-source.test.mjs",
    "test:integrations": "node --import ./tests/helpers/install-tokenization-guard.mjs --test --test-concurrency=1 tests/highlighting*.test.mjs",
    "check:editor": "node scripts/sync-editor.mjs --check",
    "prepack": "node scripts/sync-editor.mjs --check"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
