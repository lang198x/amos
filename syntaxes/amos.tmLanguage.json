{
  "name": "AMOS",
  "scopeName": "source.basic.amos",
  "fileTypes": [
    "amos.txt"
  ],
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#reserved"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#names"
    }
  ],
  "repository": {
    "strings": {
      "name": "string.quoted.double.amos",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.amos"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.amos"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.amos",
          "match": "^[ \\t]*'.*$"
        },
        {
          "begin": "(?i:(?:^[ \\t]*|:[ \\t]*)(Rem)(?![A-Za-z0-9_$#]))",
          "end": "$",
          "name": "comment.line.rem.amos",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.amos"
            }
          }
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "keyword.control.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Set[ \\t]+Double[ \\t]+Precision|On[ \\t]+Break[ \\t]+Proc|Break[ \\t]+(?:On|Off)|Every[ \\t]+(?:On|Off)|Def[ \\t]+Fn|Set[ \\t]+(?:Buffer|Stack)|Else[ \\t]+If|Exit[ \\t]+If|Pop[ \\t]+Proc|Stop|Edit|Direct|System|Fn|Sort|Inc|Dec|Add|Fix|Degree|Radian|Goto|Pop|Swap|Exit|On|Every|Data|Read|Restore|Proc|Shared|Global)(?![A-Za-z0-9_$#]))"
        },
        {
          "name": "keyword.control.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Wait[ \\t]+(?:Key|Vbl)|End[ \\t]+(?:If|Proc)|Cls|Print|End|If|Then|Else|Do|Loop|For|To|Step|Next|Repeat|Until|While|Wend|Procedure|Gosub|Return|Dim|Randomize|Wait)(?![A-Za-z0-9_$#]))"
        },
        {
          "name": "keyword.control.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Bob[ \\t]+Update[ \\t]+Off|Double[ \\t]+Buffer|Screen[ \\t]+(?:Swap|Copy)|Curs[ \\t]+Off|Flash[ \\t]+Off|Autoback|Palette|Paper|Pen|Locate|Ink|Bar|Box|Hide|Show)(?![A-Za-z0-9_$#]))"
        },
        {
          "name": "keyword.control.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Play[ \\t]+Off|Clear[ \\t]+Key|Set[ \\t]+Envel|Play|Wave|Volume)(?![A-Za-z0-9_$#]))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Param[$#]?|Pi\\#|Free|Left\\$|Right\\$|Mid\\$|Instr|Lower\\$|Val|String\\$|Space\\$|Flip\\$|Repeat\\$|Asc|Len|Match|Max|Min|Sgn|Abs|Int|Sqr|Exp|Log|Ln|Sin|Cos|Tan|Acos|Asin|Atan|Hsin|Hcos|Htan|True|False)(?![A-Za-z0-9_$#]))"
        },
        {
          "name": "support.function.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:Key[ \\t]+State|Upper\\$|Inkey\\$|Chr\\$|Str\\$|Rnd|Scancode|Physic|Logic)(?![A-Za-z0-9_$#]))"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.amos",
          "match": "(?<![A-Za-z0-9_$#])\\$[0-9A-Fa-f]+(?![A-Za-z0-9_$#])"
        },
        {
          "name": "constant.numeric.binary.amos",
          "match": "(?<![A-Za-z0-9_$#])%[01]+(?![A-Za-z0-9_$#])"
        },
        {
          "name": "constant.numeric.decimal.amos",
          "match": "(?<![A-Za-z0-9_$#])[0-9]+(?:\\.[0-9]+)?(?![A-Za-z0-9_$#])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.amos",
          "match": "(?i:(?<![A-Za-z0-9_$#])(?:And|Or|Xor|Mod|Not)(?![A-Za-z0-9_$#]))"
        },
        {
          "name": "keyword.operator.amos",
          "match": "<>|<=|>=|[+*/^=<>\\-]"
        },
        {
          "name": "punctuation.separator.amos",
          "match": "[:,;]"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.amos",
          "match": "[A-Za-z_][A-Za-z0-9_]*[$#]?"
        }
      ]
    },
    "reserved": {
      "name": "variable.language.amos",
      "match": "(?i:(?<![A-Za-z0-9_$#])Timer(?![A-Za-z0-9_$#]))"
    },
    "labels": {
      "match": "^[ \\t]*(?!(?i:Cls|Print|End|If|Then|Else|Do|Loop|For|To|Step|Next|Repeat|Until|While|Wend|Procedure|Gosub|Return|Dim|Randomize|Wait|Autoback|Palette|Paper|Pen|Locate|Ink|Bar|Box|Hide|Show|Play|Wave|Volume|Rnd|Scancode|Physic|Logic|Timer|And|Or|Mod|Xor|Inc|Dec|Add|Max|Min|Sgn|Abs|Int|Fix|Sqr|Exp|Log|Ln|Pi\\#|Degree|Radian|Sin|Cos|Tan|Acos|Asin|Atan|Hsin|Hcos|Htan|Left\\$|Right\\$|Mid\\$|Instr|Upper\\$|Lower\\$|Str\\$|Val|String\\$|Space\\$|Flip\\$|Repeat\\$|Chr\\$|Asc|Len|Sort|Match|Proc|Shared|Global|Param|Param\\#|Param\\$|Goto|Pop|True|False|Not|Swap|Exit|On|Every|Data|Read|Restore|Free|Fn|Stop|Edit|Direct|System|Rem)[ \\t]*:)([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(:)[ \\t]*$",
      "captures": {
        "1": {
          "name": "entity.name.label.amos"
        },
        "3": {
          "name": "punctuation.separator.amos"
        }
      }
    }
  }
}
